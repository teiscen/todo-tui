+package todo
+
+import (
+	"todo-tui/backend"
+	"todo-tui/leftbox"
+	"todo-tui/preview"
+)
+
+// The panes never look up labels or work out due dates themselves. These turn
+// a task into exactly what each pane draws.
+
+func (t *Todo) labelColor(id backend.LabelID) backend.HexCode {
+	return t.labels.Info[id].Color // "" for no label or an unknown one
+}
+
+func (t *Todo) rowFor(task backend.Task) leftbox.Row {
+	due, tone := task.DueInfo(t.today)
+	return leftbox.Row{
+		ID:         task.ID,
+		Kind:       task.Kind,
+		Group:      task.Group(t.today),
+		Title:      task.Title,
+		LabelID:    task.Label,
+		Color:      t.labelColor(task.Label),
+		Done:       task.Done,
+		StepsDone:  task.StepsDone,
+		StepsTotal: task.StepsTotal,
+		Schedule:   task.Schedule,
+		Due:        due,
+		DueTone:    tone,
+	}
+}
+
+func (t *Todo) detailFor(task backend.Task) preview.Detail {
+	due, tone := task.DueInfo(t.today)
+	return preview.Detail{
+		ID:         task.ID,
+		Title:      task.Title,
+		Done:       task.Done,
+		Label:      task.Label,
+		LabelColor: t.labelColor(task.Label),
+		Schedule:   task.Schedule,
+		Due:        due,
+		DueTone:    tone,
+		StepsDone:  task.StepsDone,
+		StepsTotal: task.StepsTotal,
+	}
+}
