new file mode 100644
index 0000000..81c4896
--- /dev/null
+++ b/leftbox/row.go
@@ -0,0 +1,105 @@
+package leftbox
+
+import (
+	"fmt"
+	"strings"
+
+	"todo-tui/backend"
+	"todo-tui/ui"
+
+	"charm.land/lipgloss/v2"
+	"github.com/charmbracelet/x/ansi"
+)
+
+// Row is one task, fully resolved by the root (color, group, due text).
+// The view only draws it.
+type Row struct {
+	ID    int
+	Kind  backend.Kind
+	Group backend.Group
+
+	Title   string
+	LabelID backend.LabelID
+	Color   backend.HexCode // label color, "" = no label
+
+	Done bool
+
+	StepsDone  int // the progress bar shows when StepsTotal > 0
+	StepsTotal int
+	Schedule   string // recurring rows: "M/W/F", "daily", "every 3d"
+
+	Due     string // "2d late", "today", "in 6d" ("" = nothing shown)
+	DueTone backend.Tone
+}
+
+// renderRow lays out one row as fixed columns:
+//
+//	▸ [ ] Title…            tag  ▰▰▱▱ 3/5   2d late
+func (l Leftbox) renderRow(r Row, selected bool, width int) string {
+	s := l.Style
+	dim := ui.Fg(s.Theme.Dim)
+
+	chevron := "▸"
+	if l.Expanded[r.ID] {
+		chevron = "▾"
+	}
+	if selected {
+		chevron = ui.Fg(s.Theme.Accent).Bold(true).Render(chevron)
+	} else {
+		chevron = dim.Render(chevron)
+	}
+	check := s.CheckOpen
+	if r.Done {
+		check = s.CheckDone
+	}
+
+	// chevron + space + checkbox + space, then 3 single-space gaps between columns.
+	titleW := width - (1 + 1 + lipgloss.Width(check) + 1) - 3 - s.TagWidth - s.ProgWidth - s.DueWidth
+
+	titleStyle := ui.Fg(s.Theme.Text)
+	switch {
+	case r.Done:
+		titleStyle = dim.Strikethrough(true)
+	case selected:
+		titleStyle = titleStyle.Bold(true)
+	}
+	title := titleStyle.Render(ansi.Truncate(r.Title, titleW, "…"))
+
+	tagStyle, accent := dim, s.Theme.Accent
+	if r.Color != "" {
+		tagStyle, accent = ui.Fg(r.Color), r.Color
+	}
+	tag := tagStyle.Render(ansi.Truncate(string(r.LabelID), s.TagWidth, ""))
+
+	prog := ""
+	switch {
+	case r.StepsTotal > 0:
+		n := ui.BarFill(r.StepsDone, r.StepsTotal, s.BarSegs)
+		prog = ui.Fg(accent).Render(strings.Repeat(s.BarFull, n)) +
+			dim.Render(strings.Repeat(s.BarEmpty, s.BarSegs-n)+
+				fmt.Sprintf(" %d/%d", r.StepsDone, r.StepsTotal))
+	case r.Schedule != "":
+		prog = dim.Render(ansi.Truncate(r.Schedule, s.ProgWidth, ""))
+	}
+
+	due := ui.Fg(s.Theme.ToneColor(r.DueTone)).Render(r.Due)
+
+	return strings.Join([]string{
+		chevron + " " + check + " " + ui.PadRight(title, titleW),
+		ui.PadRight(tag, s.TagWidth),
+		ui.PadRight(prog, s.ProgWidth),
+		ui.PadLeft(due, s.DueWidth),
+	}, " ")
+}
+
+// renderDetail is the extra line under an expanded row.
+func (l Leftbox) renderDetail(r Row, width int) string {
+	detail := "  No steps"
+	if r.StepsTotal > 0 {
+		detail = fmt.Sprintf("  %d/%d steps done", r.StepsDone, r.StepsTotal)
+	}
+	if r.Schedule != "" {
+		detail += " · " + r.Schedule
+	}
+	return ui.Fg(l.Style.Theme.Dim).Render(ansi.Truncate(detail, width, "…"))
+}
