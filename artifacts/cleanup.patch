diff --git a/backend/task.go b/backend/task.go
new file mode 100644
index 0000000..96a46cf
--- /dev/null
+++ b/backend/task.go
@@ -0,0 +1,113 @@
+package backend
+
+import (
+	"fmt"
+	"strings"
+)
+
+// Kind is which tab a task lives on.
+type Kind int
+
+const (
+	KindSmall Kind = iota
+	KindLong
+	KindRecurring
+	KindCount
+)
+
+var KindNames = [KindCount]string{"small", "long-term", "recurring"}
+
+// Group is the heading a task sits under in the task list.
+type Group int
+
+const (
+	GroupOverdue Group = iota
+	GroupToday
+	GroupWeek
+	GroupLater
+	GroupNoDate
+	GroupDone
+)
+
+// Tone says how urgent a due date is. The panes turn it into a color.
+type Tone int
+
+const (
+	ToneNormal Tone = iota
+	ToneSoon
+	ToneLate
+)
+
+// Task is one todo as loaded from storage.
+type Task struct {
+	ID    int
+	Kind  Kind
+	Title string
+	Label LabelID
+
+	// Due is the due date, or for a recurring task its next occurrence.
+	// nil = no date.
+	Due *Date
+	// Done is completion for a one-time task, or "done today" for a recurring one.
+	Done bool
+
+	StepsDone  int
+	StepsTotal int
+	Schedule   string // recurring only: "M/W/F", "daily", "every 3d"
+}
+
+// Group decides which heading the task sits under.
+func (t Task) Group(today Date) Group {
+	switch {
+	case t.Done:
+		return GroupDone
+	case t.Due == nil:
+		return GroupNoDate
+	}
+	days := today.DaysUntil(*t.Due)
+	switch {
+	case days < 0:
+		return GroupOverdue
+	case days == 0:
+		return GroupToday
+	case days <= 6 && t.Kind != KindRecurring:
+		return GroupWeek
+	default:
+		return GroupLater
+	}
+}
+
+// DueInfo is the text for the due column and how urgent it is.
+// Finished tasks and tasks without a date show nothing.
+func (t Task) DueInfo(today Date) (string, Tone) {
+	if t.Done || t.Due == nil {
+		return "", ToneNormal
+	}
+	days := today.DaysUntil(*t.Due)
+	switch {
+	case days < 0:
+		return fmt.Sprintf("%dd late", -days), ToneLate
+	case days == 0:
+		return "today", ToneSoon
+	case days == 1:
+		return "tmrw", ToneSoon
+	default:
+		return fmt.Sprintf("in %dd", days), ToneNormal
+	}
+}
+
+// ScheduleText turns a recurrence weekday bitmask (bit0 = Sunday) into "M/W/F".
+// Interval rules are better written by the caller: fmt.Sprintf("every %dd", n).
+func ScheduleText(mask int) string {
+	if mask&0x7F == 0x7F {
+		return "daily"
+	}
+	short := [7]string{"Su", "M", "Tu", "W", "Th", "F", "Sa"}
+	var out []string
+	for i, s := range short {
+		if mask&(1<<i) != 0 {
+			out = append(out, s)
+		}
+	}
+	return strings.Join(out, "/")
+}
diff --git a/backend/task_test.go b/backend/task_test.go
new file mode 100644
index 0000000..22d8d54
--- /dev/null
+++ b/backend/task_test.go
@@ -0,0 +1,67 @@
+package backend
+
+import (
+	"testing"
+	"time"
+)
+
+var today = NewDate(time.Date(2026, 10, 15, 0, 0, 0, 0, time.UTC))
+
+func dp(days int) *Date { d := today.AddDate(0, 0, days); return &d }
+
+func TestTaskGroup(t *testing.T) {
+	tests := []struct {
+		name string
+		task Task
+		want Group
+	}{
+		{"done wins", Task{Due: dp(-3), Done: true}, GroupDone},
+		{"no date", Task{}, GroupNoDate},
+		{"late", Task{Due: dp(-1)}, GroupOverdue},
+		{"today", Task{Due: dp(0)}, GroupToday},
+		{"in six days", Task{Due: dp(6)}, GroupWeek},
+		{"in seven days", Task{Due: dp(7)}, GroupLater},
+		{"recurring soon is later", Task{Kind: KindRecurring, Due: dp(2)}, GroupLater},
+		{"recurring today", Task{Kind: KindRecurring, Due: dp(0)}, GroupToday},
+	}
+	for _, tt := range tests {
+		if got := tt.task.Group(today); got != tt.want {
+			t.Errorf("%s: got %v want %v", tt.name, got, tt.want)
+		}
+	}
+}
+
+func TestDueInfo(t *testing.T) {
+	tests := []struct {
+		task Task
+		text string
+		tone Tone
+	}{
+		{Task{Due: dp(-2)}, "2d late", ToneLate},
+		{Task{Due: dp(0)}, "today", ToneSoon},
+		{Task{Due: dp(1)}, "tmrw", ToneSoon},
+		{Task{Due: dp(9)}, "in 9d", ToneNormal},
+		{Task{}, "", ToneNormal},
+		{Task{Due: dp(-2), Done: true}, "", ToneNormal},
+	}
+	for _, tt := range tests {
+		text, tone := tt.task.DueInfo(today)
+		if text != tt.text || tone != tt.tone {
+			t.Errorf("got (%q,%v) want (%q,%v)", text, tone, tt.text, tt.tone)
+		}
+	}
+}
+
+func TestScheduleText(t *testing.T) {
+	tests := map[int]string{
+		0x7F:               "daily",
+		1<<1 | 1<<3 | 1<<5: "M/W/F",
+		1:                  "Su",
+		1<<2 | 1<<4 | 1<<6: "Tu/Th/Sa",
+	}
+	for mask, want := range tests {
+		if got := ScheduleText(mask); got != want {
+			t.Errorf("mask %b: got %q want %q", mask, got, want)
+		}
+	}
+}
