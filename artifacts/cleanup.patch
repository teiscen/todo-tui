@@ -0,0 +1,39 @@
+package todo
+
+import tea "charm.land/bubbletea/v2"
+
+// typing is true while a pane is capturing text, so global keys must not fire.
+func (t *Todo) typing() bool {
+	return t.focus == FocusPlanner && t.planner.Typing()
+}
+
+// handleKey sends a key to exactly one place: a global key, or the focused pane.
+func (t *Todo) handleKey(key tea.KeyPressMsg) (tea.Model, tea.Cmd) {
+	s := key.String()
+	if s == "ctrl+c" {
+		return t, tea.Quit
+	}
+	if !t.typing() {
+		switch s {
+		case "q":
+			return t, tea.Quit
+		case "tab":
+			if t.focus == FocusTasks {
+				t.focus = FocusPlanner
+			} else {
+				t.focus = FocusTasks
+			}
+			return t, nil
+		}
+	}
+
+	var cmd tea.Cmd
+	switch t.focus {
+	case FocusTasks:
+		t.leftbox, cmd = t.leftbox.Update(key)
+		t.syncPreview()
+	case FocusPlanner:
+		t.planner, cmd = t.planner.Update(key)
+	}
+	return t, cmd
+}
