+++ b/backend/theme.go
@@ -0,0 +1,38 @@
+package backend
+
+// Theme is every color the panes use. It lives in config.yaml under "colors";
+// anything missing from the file keeps its default.
+type Theme struct {
+	Text    HexCode `yaml:"text"`
+	Border  HexCode `yaml:"border"`
+	Weekday HexCode `yaml:"weekday"`
+	Weekend HexCode `yaml:"weekend"`
+	Dim     HexCode `yaml:"dim"`
+	Accent  HexCode `yaml:"accent"`
+	Late    HexCode `yaml:"late"`
+	Soon    HexCode `yaml:"soon"`
+}
+
+func DefaultTheme() Theme {
+	return Theme{
+		Text:    "#C6D0F5",
+		Border:  "#C6D0F5",
+		Weekday: "#C6D0F5",
+		Weekend: "#939AB7",
+		Dim:     "#939AB7",
+		Accent:  "#CA9EE6",
+		Late:    "#E78284",
+		Soon:    "#E5C890",
+	}
+}
+
+// ToneColor is the color for a due-date tone.
+func (t Theme) ToneColor(tone Tone) HexCode {
+	switch tone {
+	case ToneLate:
+		return t.Late
+	case ToneSoon:
+		return t.Soon
+	}
+	return t.Dim
+}
