--- /dev/null
+++ b/leftbox/layout.go
@@ -0,0 +1,162 @@
+package leftbox
+
+import (
+	"fmt"
+	"strings"
+
+	"todo-tui/backend"
+	"todo-tui/ui"
+)
+
+// item is one stop for the cursor: a task row, or the heading of a collapsed
+// group (so a collapsed group can be opened again).
+type item struct {
+	row     Row
+	group   backend.Group
+	heading bool
+	n       int // heading only: tasks hidden in the group
+}
+
+// line is one drawn line of the body. item is the cursor stop it belongs to,
+// or -1 for decoration (headings of open groups, blank lines, step details).
+type line struct {
+	text string
+	item int
+}
+
+var groupNames = map[backend.Group]string{
+	backend.GroupOverdue: "OVERDUE",
+	backend.GroupToday:   "TODAY",
+	backend.GroupWeek:    "THIS WEEK",
+	backend.GroupLater:   "LATER",
+	backend.GroupNoDate:  "NO DATE",
+	backend.GroupDone:    "DONE",
+}
+
+func (l Leftbox) groupName(g backend.Group) string {
+	if l.Tab == backend.KindRecurring && g == backend.GroupLater {
+		return "OTHER DAYS"
+	}
+	return groupNames[g]
+}
+
+// layout builds the cursor stops and the body lines together, so the cursor,
+// the drawing and mouse hover can never disagree about what is where.
+func (l Leftbox) layout() ([]item, []line) {
+	s := l.Style
+	width := s.contentWidth()
+	vis := visible(l.Rows, l.Tab, l.Filter)
+
+	var items []item
+	var lines []line
+	for start := 0; start < len(vis); {
+		g := vis[start].Group
+		end := start
+		for end < len(vis) && vis[end].Group == g {
+			end++
+		}
+		group := vis[start:end]
+		start = end
+
+		if len(lines) > 0 {
+			lines = append(lines, line{item: -1})
+		}
+		if l.Collapsed[g] {
+			items = append(items, item{group: g, heading: true, n: len(group)})
+			lines = append(lines, line{text: l.heading(g, len(group), true, len(items)-1 == l.Cursor), item: len(items) - 1})
+			continue
+		}
+		lines = append(lines, line{text: l.heading(g, 0, false, false), item: -1})
+		for _, r := range group {
+			items = append(items, item{row: r, group: g})
+			idx := len(items) - 1
+			lines = append(lines, line{text: l.renderRow(r, idx == l.Cursor, width), item: idx})
+			if l.Expanded[r.ID] {
+				lines = append(lines, line{text: l.renderDetail(r, width), item: idx})
+			}
+		}
+	}
+	if len(lines) == 0 {
+		lines = []line{{text: ui.Fg(s.Theme.Dim).Render("nothing here"), item: -1}}
+	}
+	return items, lines
+}
+
+func (l Leftbox) heading(g backend.Group, hidden int, collapsed, selected bool) string {
+	c := l.Style.Theme.Dim
+	if g == backend.GroupOverdue {
+		c = l.Style.Theme.Late
+	}
+	if selected {
+		c = l.Style.Theme.Accent
+	}
+	text := l.groupName(g)
+	if collapsed {
+		text = fmt.Sprintf("▸ %s (%d)", text, hidden)
+	}
+	return ui.Fg(c).Bold(true).Render(text)
+}
+
+// frame is everything that is on screen, line by line.
+type frame struct {
+	header []string
+	body   []line // already windowed to bodyH and padded with blanks
+	footer []string
+}
+
+func (l Leftbox) frame() frame {
+	s := l.Style
+	width := s.contentWidth()
+	dim := ui.Fg(s.Theme.Dim)
+
+	header := append([]string{l.tabBar()}, l.filterLines(width)...)
+	header = append(header, "")
+
+	hints := []string{"j/k move", "space done", "f filter", "enter fold group", "e steps", "[/] tabs"}
+	for i := range hints {
+		hints[i] = dim.Render(hints[i])
+	}
+	footer := ui.WrapJoin(hints, dim.Render(" · "), width)
+
+	bodyH := max(0, s.Height-2-len(header)-len(footer))
+	_, lines := l.layout()
+
+	cursorLine := 0
+	for i, ln := range lines {
+		if ln.item == l.Cursor {
+			cursorLine = i
+			break
+		}
+	}
+	start := windowStart(len(lines), cursorLine, bodyH)
+	body := lines[start:min(len(lines), start+bodyH)]
+	for len(body) < bodyH {
+		body = append(body, line{item: -1})
+	}
+	return frame{header: header, body: body, footer: footer}
+}
+
+func (f frame) lines() []string {
+	out := append([]string{}, f.header...)
+	for _, ln := range f.body {
+		out = append(out, ln.text)
+	}
+	return append(out, f.footer...)
+}
+
+// tabBar shows every tab at the same width whether active ([x]) or not ( x ),
+// so the bar doesn't shift when you switch.
+func (l Leftbox) tabBar() string {
+	s := l.Style
+	counts := openCounts(l.Rows, l.Filter)
+	parts := make([]string, 0, backend.KindCount)
+	for i := range backend.KindCount {
+		label := fmt.Sprintf("%s %d", backend.KindNames[i], counts[i])
+		if backend.Kind(i) == l.Tab {
+			parts = append(parts, ui.Fg(s.Theme.Accent).Bold(true).Render("["+label+"]"))
+		} else {
+			parts = append(parts, ui.Fg(s.Theme.Dim).Render(" "+label+" "))
+		}
+	}
+	return strings.Join(parts, " ")
+}
