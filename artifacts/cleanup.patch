--- /dev/null
+++ b/leftbox/chips.go
@@ -0,0 +1,37 @@
+package leftbox
+
+import (
+	"todo-tui/backend"
+	"todo-tui/ui"
+
+	"charm.land/lipgloss/v2"
+)
+
+// filterLines renders colored label chips wrapped onto as many lines as needed.
+func (l Leftbox) filterLines(width int) []string {
+	chip := func(name string, c backend.HexCode, active bool) string {
+		text := " " + name + " "
+		if active {
+			text = "[" + name + "]"
+		}
+		return lipgloss.NewStyle().Foreground(ui.Color(c)).Bold(active).Render(text)
+	}
+
+	chips := []string{chip("all", l.Style.Theme.Text, l.Filter == "")}
+	for _, id := range l.Labels.Order {
+		chips = append(chips, chip(string(id), l.Labels.Info[id].Color, l.Filter == id))
+	}
+	return ui.WrapJoin(chips, " ", width)
+}
+
+// stepFilter cycles all -> each label in order -> all.
+func (l *Leftbox) stepFilter() {
+	order := append([]backend.LabelID{""}, l.Labels.Order...)
+	for i, id := range order {
+		if id == l.Filter {
+			l.Filter = order[(i+1)%len(order)]
+			return
+		}
+	}
+	l.Filter = ""
+}
