index 0000000..b5d5b35
--- /dev/null
+++ b/leftbox/leftbox_test.go
@@ -0,0 +1,126 @@
+package leftbox
+
+import (
+	"strings"
+	"testing"
+
+	"todo-tui/backend"
+
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/charmbracelet/x/ansi"
+)
+
+func rows() []Row {
+	mk := func(id int, g backend.Group, title string) Row {
+		return Row{ID: id, Kind: backend.KindSmall, Group: g, Title: title, LabelID: "uni"}
+	}
+	return []Row{
+		mk(1, backend.GroupOverdue, "a"),
+		mk(2, backend.GroupToday, "b"),
+		mk(3, backend.GroupToday, "c"),
+		mk(4, backend.GroupLater, "d"),
+		{ID: 5, Kind: backend.KindLong, Group: backend.GroupLater, Title: "long"},
+	}
+}
+
+func newBox() Leftbox {
+	labels := backend.Labels{Order: []backend.LabelID{"uni"}, Info: map[backend.LabelID]backend.LabelInfo{"uni": {Color: "#81c8be"}}}
+	l := New(backend.DefaultTheme(), labels)
+	l.ReloadState(rows())
+	return l
+}
+
+func press(l Leftbox, k string) Leftbox {
+	var msg tea.KeyPressMsg
+	switch k {
+	case "enter":
+		msg = tea.KeyPressMsg{Code: tea.KeyEnter}
+	case "space":
+		msg = tea.KeyPressMsg{Code: tea.KeySpace}
+	default:
+		msg = tea.KeyPressMsg{Code: rune(k[0]), Text: k}
+	}
+	l, _ = l.Update(msg)
+	return l
+}
+
+func TestViewIsExactlyPaneSize(t *testing.T) {
+	l := newBox()
+	out := strings.Split(l.View(), "\n")
+	if len(out) != l.Style.Height {
+		t.Fatalf("height %d, want %d", len(out), l.Style.Height)
+	}
+	for i, ln := range out {
+		if w := lipgloss.Width(ln); w != l.Style.Width {
+			t.Fatalf("line %d width %d, want %d: %q", i, w, l.Style.Width, ansi.Strip(ln))
+		}
+	}
+}
+
+func TestHoverMatchesDrawing(t *testing.T) {
+	l := newBox()
+	f := l.frame()
+	for i, ln := range f.body {
+		if ln.item < 0 {
+			continue
+		}
+		l.Cursor = 0
+		y := 1 + len(f.header) + i
+		l.HoverAt(y)
+		items, _ := l.layout()
+		if l.Cursor != ln.item {
+			t.Errorf("y=%d moved cursor to %d, want %d", y, l.Cursor, ln.item)
+		}
+		if !strings.Contains(ansi.Strip(ln.text), items[ln.item].row.Title) && !items[ln.item].heading {
+			t.Errorf("y=%d line %q is not row %q", y, ansi.Strip(ln.text), items[ln.item].row.Title)
+		}
+	}
+}
+
+func TestCollapseKeepsHeadingReachable(t *testing.T) {
+	l := newBox()
+	l = press(l, "j") // on "b" in TODAY
+	l = press(l, "enter")
+	if _, ok := l.Selected(); ok {
+		t.Fatal("cursor should be on the folded heading")
+	}
+	items, _ := l.layout()
+	if !items[l.Cursor].heading || items[l.Cursor].n != 2 {
+		t.Fatalf("want folded TODAY heading with 2 hidden, got %+v", items[l.Cursor])
+	}
+	l = press(l, "enter") // open again
+	if r, ok := l.Selected(); !ok || r.ID != 2 {
+		t.Fatalf("after reopening want first row of TODAY, got %+v %v", r, ok)
+	}
+}
+
+func TestReloadKeepsSelectionByID(t *testing.T) {
+	l := newBox()
+	l = press(l, "j")
+	l = press(l, "j") // row 3
+	re := rows()
+	re[0].Done = true // order is unchanged, but something else moved
+	re = append([]Row{{ID: 9, Kind: backend.KindSmall, Group: backend.GroupOverdue, Title: "new"}}, re...)
+	l.ReloadState(re)
+	if r, _ := l.Selected(); r.ID != 3 {
+		t.Fatalf("selection moved to %d", r.ID)
+	}
+}
+
+func TestTabsFilterAndToggle(t *testing.T) {
+	l := newBox()
+	l = press(l, "]")
+	if r, ok := l.Selected(); !ok || r.ID != 5 {
+		t.Fatalf("long tab selection %+v", r)
+	}
+	l, cmd := l.Update(tea.KeyPressMsg{Code: tea.KeySpace, Text: " "})
+	if msg, ok := cmd().(ToggleTodoMsg); !ok || msg.ID != 5 {
+		t.Fatalf("toggle msg %+v", msg)
+	}
+	l = press(l, "[")
+	l = press(l, "f") // filter to uni
+	if n := len(visible(l.Rows, l.Tab, l.Filter)); n != 4 {
+		t.Fatalf("uni filter shows %d rows", n)
+	}
+}
