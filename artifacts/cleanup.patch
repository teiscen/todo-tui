@@ -0,0 +1,53 @@
+package database
+
+import (
+	"testing"
+	"time"
+
+	"todo-tui/backend"
+)
+
+func TestEntriesRoundTrip(t *testing.T) {
+	db, err := ConnectDB(":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1) // ":memory:" is per connection
+
+	if err := CreateTables(db); err != nil {
+		t.Fatal(err)
+	}
+	if err := CreateTables(db); err != nil { // safe to repeat
+		t.Fatal(err)
+	}
+	labels := backend.Labels{
+		Order: []backend.LabelID{"uni"},
+		Info:  map[backend.LabelID]backend.LabelInfo{"uni": {Name: "University", Color: "#81c8be"}},
+	}
+	if err := SyncLabels(db, labels); err != nil {
+		t.Fatal(err)
+	}
+
+	day := backend.NewDate(time.Date(2026, 10, 15, 0, 0, 0, 0, time.UTC))
+	if err := AddEntry(db, day.FormatSQL(), "uni", "lecture"); err != nil {
+		t.Fatal(err)
+	}
+	if err := AddEntry(db, day.FormatSQL(), "uni", "lecture + lab"); err != nil {
+		t.Fatal(err)
+	}
+	got, err := FetchGridEntries(db, day.AddDate(0, 0, -1), day.AddDate(0, 0, 1), "uni")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got[day.Key()] != "lecture + lab" || len(got) != 1 {
+		t.Fatalf("got %v", got)
+	}
+	if err := RemoveEntry(db, day.FormatSQL(), "uni"); err != nil {
+		t.Fatal(err)
+	}
+	got, _ = FetchGridEntries(db, day, day, "uni")
+	if len(got) != 0 {
+		t.Fatalf("entry not removed: %v", got)
+	}
+}
diff --git a/database/schema.sql b/database/schema.sql
new file mode 100644
index 0000000..50c7288
--- /dev/null
+++ b/database/schema.sql
@@ -0,0 +1,81 @@
+-- Every statement is IF NOT EXISTS, so running this on each start is safe.
+
+CREATE TABLE IF NOT EXISTS labels (
+    name  TEXT PRIMARY KEY,
+    color TEXT NOT NULL
+);
+
+CREATE TABLE IF NOT EXISTS todos (
+    id         INTEGER PRIMARY KEY AUTOINCREMENT,
+    title      TEXT NOT NULL,
+    label_id   TEXT REFERENCES labels(name) ON UPDATE CASCADE ON DELETE SET NULL,
+    horizon    TEXT NOT NULL DEFAULT 'small' CHECK (horizon IN ('small', 'long')),
+    due_date   TEXT,
+    notes      TEXT NOT NULL DEFAULT '',
+    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),
+    done_at    TEXT
+);
+
+CREATE TABLE IF NOT EXISTS steps (
+    id         INTEGER PRIMARY KEY AUTOINCREMENT,
+    todo_id    INTEGER NOT NULL REFERENCES todos(id) ON DELETE CASCADE,
+    pos        INTEGER NOT NULL,
+    text       TEXT NOT NULL,
+    status     TEXT NOT NULL DEFAULT 'todo' CHECK (status IN ('todo', 'started', 'done')),
+    started_at TEXT,
+    done_at    TEXT,
+    due_date   TEXT,
+    UNIQUE (todo_id, pos)
+);
+
+CREATE TABLE IF NOT EXISTS step_notes (
+    id         INTEGER PRIMARY KEY AUTOINCREMENT,
+    step_id    INTEGER NOT NULL REFERENCES steps(id) ON DELETE CASCADE,
+    body       TEXT NOT NULL,
+    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))
+);
+
+CREATE TABLE IF NOT EXISTS recurrence (
+    todo_id       INTEGER PRIMARY KEY REFERENCES todos(id) ON DELETE CASCADE,
+    kind          TEXT NOT NULL CHECK (kind IN ('daily', 'weekdays', 'interval')),
+    weekdays      INTEGER NOT NULL DEFAULT 0 CHECK (weekdays BETWEEN 0 AND 127),
+    interval_days INTEGER CHECK (interval_days IS NULL OR interval_days > 0),
+    start_date    TEXT NOT NULL,
+    end_date      TEXT,
+    CHECK (kind <> 'weekdays' OR weekdays > 0),
+    CHECK (kind <> 'interval' OR interval_days IS NOT NULL)
+);
+
+CREATE TABLE IF NOT EXISTS completions (
+    todo_id INTEGER NOT NULL REFERENCES todos(id) ON DELETE CASCADE,
+    date    TEXT NOT NULL,
+    PRIMARY KEY (todo_id, date)
+) WITHOUT ROWID;
+
+CREATE TABLE IF NOT EXISTS time_log (
+    id      INTEGER PRIMARY KEY AUTOINCREMENT,
+    todo_id INTEGER NOT NULL REFERENCES todos(id) ON DELETE CASCADE,
+    step_id INTEGER REFERENCES steps(id) ON DELETE SET NULL,
+    date    TEXT NOT NULL,
+    minutes INTEGER NOT NULL CHECK (minutes > 0)
+);
+
+CREATE TABLE IF NOT EXISTS links (
+    id      INTEGER PRIMARY KEY AUTOINCREMENT,
+    todo_id INTEGER NOT NULL REFERENCES todos(id) ON DELETE CASCADE,
+    label   TEXT NOT NULL,
+    url     TEXT NOT NULL
+);
+
+CREATE TABLE IF NOT EXISTS entries (
+    date       TEXT NOT NULL,
+    label_name TEXT NOT NULL REFERENCES labels(name) ON UPDATE CASCADE ON DELETE CASCADE,
+    msg        TEXT NOT NULL DEFAULT '',
+    PRIMARY KEY (date, label_name)
+);
+
+CREATE INDEX IF NOT EXISTS idx_todos_open_due ON todos(due_date) WHERE done_at IS NULL;
+CREATE INDEX IF NOT EXISTS idx_todos_label    ON todos(label_id);
+CREATE INDEX IF NOT EXISTS idx_steps_todo     ON steps(todo_id, pos);
+CREATE INDEX IF NOT EXISTS idx_steps_due      ON steps(due_date) WHERE status <> 'done';
+CREATE INDEX IF NOT EXISTS idx_time_todo_date ON time_log(todo_id, date);
