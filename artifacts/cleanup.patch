+package todo
+
+import (
+	"strings"
+	"testing"
+
+	"todo-tui/backend"
+	"todo-tui/config"
+
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+)
+
+func newTodo(t *testing.T) *Todo {
+	t.Helper()
+	cfg := config.Config{
+		Colors: backend.DefaultTheme(),
+		Labels: backend.Labels{
+			Selected: "uni",
+			Order:    []backend.LabelID{"uni", "work"},
+			Info: map[backend.LabelID]backend.LabelInfo{
+				"uni":  {Name: "University", Color: "#81c8be"},
+				"work": {Name: "Work", Color: "#ca9ee6"},
+			},
+		},
+	}
+	return NewTodo(cfg, nil)
+}
+
+func key(t *Todo, k string) {
+	var m tea.KeyPressMsg
+	switch k {
+	case "tab":
+		m = tea.KeyPressMsg{Code: tea.KeyTab}
+	default:
+		m = tea.KeyPressMsg{Code: rune(k[0]), Text: k}
+	}
+	t.Update(m)
+}
+
+func TestKeysGoToFocusedPaneOnly(t *testing.T) {
+	td := newTodo(t)
+	before := td.leftbox.Cursor
+	key(td, "j")
+	if td.leftbox.Cursor != before+1 {
+		t.Fatal("j should move the task cursor while tasks are focused")
+	}
+
+	key(td, "tab")
+	if td.focus != FocusPlanner {
+		t.Fatal("tab should focus the planner")
+	}
+	c := td.leftbox.Cursor
+	key(td, "j")
+	if td.leftbox.Cursor != c {
+		t.Fatal("j must not reach the task list while the planner is focused")
+	}
+}
+
+func TestPreviewFollowsCursor(t *testing.T) {
+	td := newTodo(t)
+	first := td.preview.Detail.ID
+	key(td, "j")
+	if td.preview.Detail == nil || td.preview.Detail.ID == first {
+		t.Fatal("preview should show the newly selected task")
+	}
+}
+
+func TestPaneHeightsMatch(t *testing.T) {
+	td := newTodo(t)
+	want := td.leftbox.Style.Height
+	for name, v := range map[string]string{
+		"leftbox": td.leftbox.View(), "preview": td.preview.View(), "planner": td.planner.View(),
+	} {
+		if h := lipgloss.Height(v); h != want {
+			t.Errorf("%s is %d rows, want %d", name, h, want)
+		}
+	}
+	if w := lipgloss.Width(strings.Split(td.View().Content, "\n")[0]); w != 130 {
+		t.Errorf("total width %d, want 130", w)
+	}
+}
+
+func TestStaleLoadIsIgnored(t *testing.T) {
+	td := newTodo(t)
+	td.Update(plannerLoadedMsg{label: "work", start: gridStart(td.planner.SelectedDate()), entries: map[string]string{"x": "y"}})
+	if len(td.planner.Entries) != 0 {
+		t.Fatal("a result for another label must be dropped")
+	}
+}
