diff --git a/backend/date_test.go b/backend/date_test.go
new file mode 100644
index 0000000..9b4a7b4
--- /dev/null
+++ b/backend/date_test.go
@@ -0,0 +1,39 @@
+package backend
+
+import (
+	"testing"
+	"time"
+)
+
+func d(y int, m time.Month, day int) Date {
+	return NewDate(time.Date(y, m, day, 15, 30, 0, 0, time.Local))
+}
+
+func TestAddMonthsClampsDay(t *testing.T) {
+	if got := d(2026, 1, 31).AddMonths(1); got.Key() != d(2026, 2, 28).Key() {
+		t.Errorf("Jan 31 + 1 month = %s", got.Key())
+	}
+	if got := d(2026, 3, 31).AddMonths(-1); got.Key() != d(2026, 2, 28).Key() {
+		t.Errorf("Mar 31 - 1 month = %s", got.Key())
+	}
+	if got := d(2026, 12, 15).AddMonths(1); got.Key() != d(2027, 1, 15).Key() {
+		t.Errorf("Dec 15 + 1 month = %s", got.Key())
+	}
+}
+
+func TestMonthBounds(t *testing.T) {
+	x := d(2028, 2, 10)
+	if x.FirstDay().Day() != 1 || x.LastDay().Day() != 29 || x.NumDays() != 29 {
+		t.Errorf("Feb 2028: first %d last %d days %d", x.FirstDay().Day(), x.LastDay().Day(), x.NumDays())
+	}
+}
+
+func TestDaysUntilAndCompare(t *testing.T) {
+	a, b := d(2026, 10, 15), d(2026, 10, 20)
+	if a.DaysUntil(b) != 5 || b.DaysUntil(a) != -5 || a.DaysUntil(a) != 0 {
+		t.Error("DaysUntil")
+	}
+	if a.Compare(b) >= 0 || b.Compare(a) <= 0 || !a.Equal(d(2026, 10, 15)) {
+		t.Error("Compare/Equal")
+	}
+}
